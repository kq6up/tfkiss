# tfkiss.ini - configuration file for tfkiss
# Generated by configure. Edit this file to match your system.
#
# IMPORTANT: Set your callsign in tfkiss.cfg and verify the
# serial device path matches your TNC connection.

# Directory for config files
tfkiss_conf_dir @tfkiss_conf_dir@

# Directory for log files
tfkiss_log_dir @tfkiss_log_dir@

# Directory for status/run files
tfkiss_run_dir @tfkiss_run_dir@

# File containing process id
tfkiss_procfile tfkiss.pid

# Log file for errors
tfkiss_errfile tfkiss.err

# Save file for parameters
tfkiss_parafile tfkiss.par

# UNIX socket for connection to TNT/dpbox
tfkiss_socket tfkiss_socket

# Config file for AXIP port (if enabled)
tfkiss_axipconfig tfkiss.cfg

# Serial device for TNC connection
# Common values:
#   Linux built-in serial:  /dev/ttyS0
#   Linux USB-to-serial:    /dev/ttyUSB0
#   NetBSD built-in serial: /dev/tty00
#   NetBSD USB-to-serial:   /dev/ttyU0
#   DragonFly:              /dev/ttyd0
#   Solaris:                /dev/ttya
device @tfkiss_device@

# Lockfile for serial device (adjust to match your device name)
#tfkiss_lockfile /var/spool/uucp/LCK..ttyS0

# Speed on serial device for KISS port
speed 19200

# Switch KISS TNC to full duplex if DAMA detected
fulldup_on_dama 1

# IP socket for connection to TNT (optional)
#tfkiss_extsocket *:5000

# Type of KISS on kiss port:
#   0: KISS (standard, most compatible)
#   1: SMACK
#   2: RMNC-KISS
kisstype 0

# Enable (1) or disable (0) KISS port
kiss_active 1

# Enable (1) or disable (0) AXIP port
axip_active 0
