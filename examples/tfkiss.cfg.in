# tfkiss.cfg - AXIP configuration file for tfkiss
# Generated by configure. Edit this file to match your system.
#
# IMPORTANT: Replace NOCALL with your actual amateur radio callsign.

# Select active socket types
# syntax: socket <ip|udp> [udp-port]
socket ip
socket udp

# Mode of operation: digi or tnc
mode tnc

# Your amateur radio callsign (REQUIRED - replace NOCALL)
mycall NOCALL

# Log level:
#   0 - no output
#   1 - config info only
#   2 - major events and errors
#   3 - major events, errors, and AX25 frame trace
#   4 - all events
loglevel 2

# Route definitions
# syntax: route <callsign> <hostname> [udp] [udp-port]
# Examples:
#route W6XYZ-1 nexthost.example.com
#route W6XYZ-2 otherhost.example.com udp
#route W6XYZ-3 localhost udp 10094
#
# Catch-all route (use with care):
#route default otherhost.example.com
